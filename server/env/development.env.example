NODE_ENV=development
PORT=4000
AUTH_SESSION_HOURS=12
MAX_LOGIN_FAILURES=5
LOCK_MINUTES=15

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ridgefield Academy <no-reply@localhost>"
SMTP_REPLY_TO=

EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
AUTOMATION_WORKER_POLL_MS=30000

# Security
ALLOWED_ORIGINS=http://localhost:4000
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_AUTH=20

# Cookie authentication
SESSION_COOKIE_NAME=rf_session
CSRF_COOKIE_NAME=rf_csrf
COOKIE_SECURE=false
