NODE_ENV=production
PORT=4000
AUTH_SESSION_HOURS=8
MAX_LOGIN_FAILURES=5
LOCK_MINUTES=30

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ridgefield Academy <no-reply@ridgefield.example>"
SMTP_REPLY_TO=

EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=20
AUTOMATION_WORKER_POLL_MS=30000

# Security
ALLOWED_ORIGINS=https://ridgefield.example,https://www.ridgefield.example
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_AUTH=20

# Cookie authentication
SESSION_COOKIE_NAME=rf_session
CSRF_COOKIE_NAME=rf_csrf
COOKIE_SECURE=true
